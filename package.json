{
  "name": "anthill-sim",
  "version": "1.1.0",
  "private": true,
  "description": "Agent-based simulation of a Pogonomyrmex badius colony",
  "type": "module",
  "license": "MIT",
  "author": "Adrian Diez Cuadrado",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "headless": "tsx headless/run.ts",
    "study": "tsx headless/study.ts",
    "measure:nest": "tsx tools/measure-nest-over-time.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.20.1",
    "eslint": "^9.17.0",
    "eslint-plugin-import-x": "^4.6.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
